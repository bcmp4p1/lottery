{
  "name": "lottery",
  "version": "0.1.0",
  "private": true,
  "description": "Online lottery platform MVP (Next.js + NestJS + Supabase)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver",
      "@nestjs/core"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:web": "pnpm --filter @lottery/web dev",
    "dev:api": "pnpm --filter @lottery/api dev"
  }
}
